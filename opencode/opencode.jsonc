{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6-astra",
  "small_model": "openai/gpt-5.6-luna-fast",
  "agent": {
    "build": {
      "model": "openai/gpt-5.6-luna",
      "variant": "high"
    },
    "explore": {
      "description": "Read-only codebase exploration for broad discovery and call-path mapping",
      "hidden": true,
      "mode": "subagent",
      "permission": {
        "bash": "deny",
        "edit": "deny",
        "task": "deny",
        "write": "deny"
      },
      "prompt": "Inspect only the requested scope. Use CodeGraph before broad filesystem searches. Do not edit, write, run shell commands, or delegate. Return concise findings with file paths, symbols, call paths, and unresolved uncertainty."
    },
    "general": {
      "disable": true
    },
    "plan": {
      "model": "openai/gpt-6-astra",
      "variant": "high"
    }
  },
  "autoupdate": true,
  "default_agent": "build",
  "experimental": {
    "mcp_timeout": 180000
  },
  "formatter": {
    "biome": {
      "command": [
        "npx",
        "biome",
        "format",
        "--write",
        "$FILE"
      ],
      "extensions": [
        ".js",
        ".jsx",
        ".ts",
        ".tsx",
        ".json",
        ".jsonc"
      ]
    }
  },
  "mcp": {
    "airtable": {
      "command": [
        "npx",
        "-y",
        "airtable-mcp-server"
      ],
      "environment": {
        "AIRTABLE_API_KEY": "{env:OPENCODE_AIRTABLE_API_KEY}"
      },
      "type": "local"
    },
    "analytics": {
      "command": [
        "uvx",
        "analytics-mcp"
      ],
      "environment": {
        "GOOGLE_APPLICATION_CREDENTIALS": "{env:OPENCODE_GSC_CREDENTIALS_PATH}",
        "GOOGLE_PROJECT_ID": "general-mcp-507607"
      },
      "type": "local"
    },
    "codegraph": {
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "type": "local"
    },
    "context7": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "elevenlabs": {
      "command": [
        "uvx",
        "elevenlabs-mcp"
      ],
      "environment": {
        "ELEVENLABS_API_KEY": "{env:OPENCODE_ELEVENLABS_API_KEY}",
        "ELEVENLABS_API_RESIDENCY": "eu-residency"
      },
      "type": "local"
    },
    "engram": {
      "command": [
        "engram",
        "mcp",
        "--tools=agent"
      ],
      "type": "local"
    },
    "gsc": {
      "command": [
        "uvx",
        "mcp-search-console"
      ],
      "environment": {
        "GSC_CREDENTIALS_PATH": "{env:OPENCODE_GSC_CREDENTIALS_PATH}",
        "GSC_SKIP_OAUTH": "true"
      },
      "type": "local"
    },
    "holded": {
      "oauth": {},
      "type": "remote",
      "url": "https://mcp.holded.com/mcp"
    },
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp"
    },
    "logfire": {
      "type": "remote",
      "url": "https://logfire-eu.pydantic.dev/mcp"
    },
    "next-devtools": {
      "command": [
        "npx",
        "-y",
        "next-devtools-mcp@latest"
      ],
      "type": "local"
    },
    "playwright": {
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "enabled": true,
      "type": "local"
    },
    "slack": {
      "enabled": true,
      "oauth": {
        "clientId": "{env:OPENCODE_SLACK_CLIENT_ID}",
        "clientSecret": "{env:OPENCODE_SLACK_CLIENT_SECRET}",
        "redirectUri": "http://127.0.0.1:19876/mcp/oauth/callback"
      },
      "type": "remote",
      "url": "https://mcp.slack.com/mcp"
    },
    "supabase": {
      "oauth": {},
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp?read_only=true"
    }
  },
  "permission": {
    "bash": {
      "*": "allow",
      ":(){:|:&};:": "deny",
      "git commit *": "allow",
      "git push": "allow",
      "git push *": "allow",
      "git push --force *": "ask",
      "git rebase *": "ask",
      "git reset --hard *": "ask",
      "rm -rf /": "deny",
      "rm -rf /*": "deny",
      "rm -rf ~": "deny",
      "rm -rf ~/*": "deny",
      "sudo *": "deny"
    },
    "external_directory": "allow",
    "read": {
      "*": "allow",
      "**/*.key": "deny",
      "**/*.pem": "deny",
      "**/.aws/credentials": "deny",
      "**/.config/gh/hosts.yml": "deny",
      "**/.credentials/**": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/.ssh/**": "deny",
      "**/Library/Keychains/**": "deny",
      "**/credentials.json": "deny",
      "**/secrets/**": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      ".env": "ask",
      ".env-*": "ask",
      ".env.*": "ask"
    }
  },
  "plugin": [
    "@warp-dot-dev/opencode-warp",
    "@dietrichgebert/ponytail",
    "./plugins/caveman/plugin.js"
  ],
  "provider": {
    "anthropic": {
      "options": {
        "chunkTimeout": 120000,
        "timeout": 600000
      }
    },
    "ollama": {
      "models": {
        "qwen3.5:9b-q4_K_M": {
          "name": "Qwen 3.5 9B Q4_K_M"
        }
      },
      "name": "Ollama (local)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      }
    },
    "openai": {
      "options": {
        "chunkTimeout": 120000,
        "headerTimeout": 120000,
        "timeout": 600000
      }
    }
  },
  "share": "disabled",
  "skills": {
    "paths": [
      "skills"
    ]
  }
}
